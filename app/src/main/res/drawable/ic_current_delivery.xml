<?xml version="1.0" encoding="utf-8"?>
<!-- Compact stop dots on the Map Page (8dp, centered over each GPS position).
     This replaces the former large pin without changing navigation or route data. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size android:width="8dp" android:height="8dp" />
    <solid android:color="#F02828" />
    <stroke android:width="0.6dp" android:color="#FFFFFF" />
</shape>
