<?xml version="1.0" encoding="utf-8"?>
<!--
    3D yellow Perodua Axia with transparent outer pixels and no platform.
    Preserve the #817 32dp frame and existing 1.8x GPS icon scale.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_gps_axia_3d"
            android:gravity="fill" />
    </item>
</layer-list>
