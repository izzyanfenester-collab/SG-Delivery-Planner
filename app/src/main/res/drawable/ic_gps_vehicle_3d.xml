<?xml version="1.0" encoding="utf-8"?>
<!-- SG Delivery: perspective, beveled/extruded navigational arrow with transparent exterior.
     Purposefully different from the flat 2D puck. Always points to the top/north before GPS rotation. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp" android:height="52dp"
    android:viewportWidth="96" android:viewportHeight="112">
    <!-- Very close directional shadow, no circular or white puck background -->
    <path android:fillColor="#80000820"
        android:pathData="M48,20 L86,89 Q88,96 80,97 L54,83 L48,82 L42,83 L16,97 Q8,96 10,89 Z"/>
    <!-- Lower extrusion: navy sides below white-rimmed upper shell -->
    <path android:fillColor="#062745"
        android:pathData="M48,10 L84,80 L80,94 L52,78 L48,77 L44,78 L16,94 L12,80 Z"/>
    <path android:fillColor="#0D568A"
        android:pathData="M48,10 L84,80 L80,94 L53,78 L49,75 L48,56 Z"/>
    <path android:fillColor="#287BAF"
        android:pathData="M48,10 L48,56 L47,75 L43,78 L16,94 L12,80 Z"/>
    <!-- Thick porcelain-white perimeter for strong visibility on dark and light maps -->
    <path android:fillColor="#F7FCFF" android:strokeColor="#FFFFFF"
        android:strokeWidth="1.25" android:strokeLineJoin="round"
        android:pathData="M48,6 L83,76 Q85,81 80,84 Q78,86 75,84 L52,69 Q48,67 44,69 L21,84 Q18,86 16,84 Q11,81 13,76 Z"/>
    <!-- Main upper-blue angled body; deep left/right contrast creates 3D ridge -->
    <path android:fillColor="#1178B9"
        android:pathData="M48,17 L74,75 L51,60 Q48,58 45,60 L22,75 Z"/>
    <path android:fillColor="#51C3F1"
        android:pathData="M48,17 L48,58 L45,60 L22,75 L29,59 Z"/>
    <path android:fillColor="#17699F"
        android:pathData="M48,17 L74,75 L51,60 L48,58 Z"/>
    <!-- Beveled side surfaces / bright centerline -->
    <path android:fillColor="#B5EBFA"
        android:pathData="M47,23 L32,60 L40,53 L48,28 Z"/>
    <path android:fillColor="#0A4876" android:fillAlpha="0.78"
        android:pathData="M50,30 L69,67 L56,58 L51,50 Z"/>
    <path android:fillColor="#E6F9FF"
        android:pathData="M48,17 L50,30 L48,55 L46,57 Z"/>
    <!-- Rear undercut emphasizes three-dimensional elevation -->
    <path android:fillColor="#092D4B"
        android:pathData="M23,77 L45,63 Q48,61 51,63 L73,77 L51,67 Q48,65 45,67 Z"/>
</vector>