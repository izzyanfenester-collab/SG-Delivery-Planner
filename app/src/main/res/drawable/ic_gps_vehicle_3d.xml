<?xml version="1.0" encoding="utf-8"?>
<!-- TomTom-inspired blue chevron: white rim, 3D blue faces, no white GPS puck. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Shape-only shadow, never a circular or elliptical background. -->
    <path
        android:fillColor="#72071220"
        android:pathData="M48,27 L81,61 Q84,66 80,70 L52,61 Q48,60 44,61 L16,70 Q12,66 15,61 Z" />

    <!-- Dark extrusion on the trailing edge of the chevron. -->
    <path
        android:fillColor="#174767"
        android:pathData="M48,24 L79,58 Q82,62 78,67 L51,58 Q48,57 45,58 L18,67 Q14,62 17,58 Z" />

    <!-- Thick white border from the reference TomTom arrow. -->
    <path
        android:fillColor="#F6FCFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineJoin="round"
        android:pathData="M48,23 L78,57 Q82,61 78,64 Q77,65 75,64 L51,55 Q48,54 45,55 L21,64 Q19,65 18,64 Q14,61 18,57 Z" />

    <!-- Raised blue face with a V-shaped recessed tail. -->
    <path
        android:fillColor="#2B88C2"
        android:pathData="M48,29 L72,57 L51,49 Q48,48 45,49 L24,57 Z" />

    <!-- Light left face, deep-blue right face for a 3D look. -->
    <path
        android:fillColor="#4FAED7"
        android:pathData="M48,29 L48,48 L45,49 L24,57 Z" />
    <path
        android:fillColor="#17699E"
        android:pathData="M48,29 L72,57 L51,49 L48,48 Z" />

    <!-- Upper highlight and central fold. -->
    <path
        android:fillColor="#A9E2F8"
        android:fillAlpha="0.9"
        android:pathData="M47,31 L29,53 L35,50 L48,35 Z" />
    <path
        android:fillColor="#104E76"
        android:fillAlpha="0.42"
        android:pathData="M48,48 L45,49 L24,57 L45,52 Q48,51 51,52 L72,57 L51,49 Z" />
</vector>
